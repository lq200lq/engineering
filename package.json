{
  "name": "engineering-harness",
  "version": "0.1.0",
  "description": "本地优先的工程规范解析与校验 CLI",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "eng": "dist/cli.js"
  },
  "files": [
    "dist/**",
    "assets/**",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lq200lq/engineering.git"
  },
  "homepage": "https://github.com/lq200lq/engineering#readme",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "package:check": "npm run build && node scripts/prepare-package.mjs && node scripts/check-package.mjs",
    "prepack": "npm run build && node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
