{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["standards", "rules"],
  "properties": {
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/definitions/semver" }
      }
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
      "additionalProperties": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "always": { "const": true },
        "when": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*$" },
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "path": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "checks": { "type": "array", "items": { "$ref": "#/definitions/check" } }
      },
      "oneOf": [
        { "required": ["always"], "not": { "required": ["when"] } },
        { "required": ["when"], "not": { "required": ["always"] } }
      ]
    },
    "level": { "enum": ["mandatory", "recommended", "guideline"] },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "pattern"],
          "properties": {
            "type": { "const": "file_exists" },
            "level": { "$ref": "#/definitions/level" },
            "pattern": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "name"],
          "properties": {
            "type": { "enum": ["dependency_present", "dependency_absent"] },
            "level": { "$ref": "#/definitions/level" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "pattern"],
          "properties": {
            "type": { "const": "migration_exists" },
            "level": { "$ref": "#/definitions/level" },
            "pattern": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
